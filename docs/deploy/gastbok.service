# /etc/systemd/system/gastbok.service
[Unit]
Description=Gastbok Django app
After=network.target

[Service]
User=karlal
Group=www-data
WorkingDirectory=/srv/gastbok/current
EnvironmentFile=/etc/gastbok/gastbok.env
ExecStart=/srv/gastbok/current/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
